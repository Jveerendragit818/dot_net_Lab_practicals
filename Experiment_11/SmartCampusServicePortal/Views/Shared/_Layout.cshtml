
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Smart Campus Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    
    <div class="sidebar">
        <h3 class="sidebar-title">Smart Campus</h3>

        <a asp-controller="Home" asp-action="Index">
            Dashboard
        </a>

        <a asp-controller="Students" asp-action="Index">
            Students
        </a>

        <a asp-controller="ServiceRequests" asp-action="Index">
            Service Requests
        </a>

        <a asp-controller="Notices" asp-action="Index">
            Notices
        </a>

        <a asp-controller="Events" asp-action="Index">
            Campus Events
        </a>

        <hr />

        <a href="/api/CampusApi">
            Students API
        </a>

        <a href="/api/ServiceRequests">
            Requests API
        </a>
    </div>


    <main class="main-content">
        <header class="topbar">
            <h4>Smart Campus Service Portal</h4>
            <span>Campus Management System</span>
        </header>

        <div class="page-content">
            @RenderBody()
        </div>

        <footer class="text-center mt-5 text-muted">
            © 2026 Smart Campus Service Portal
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
