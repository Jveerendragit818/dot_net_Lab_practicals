@model IEnumerable<SmartCampusServicePortal.Models.Notice>

<h2>Campus Notices</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Notice
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Posted Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.PostedDate?.ToString("dd-MM-yyyy")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete notice?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>